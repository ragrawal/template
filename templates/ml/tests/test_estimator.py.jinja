import numpy as np

from {{ package_name }}.estimator import HousePredictionModel
from {{ package_name }}.schema import HouseFrame


def _synthetic_frame(n: int) -> HouseFrame:
    rng = np.random.default_rng(42)
    return HouseFrame(
        med_inc=rng.uniform(1, 10, n),
        house_age=rng.uniform(1, 50, n),
        ave_rooms=rng.uniform(2, 10, n),
        ave_bedrms=rng.uniform(1, 3, n),
        population=rng.uniform(100, 5000, n),
        ave_occup=rng.uniform(1, 6, n),
        latitude=rng.uniform(32, 42, n),
        longitude=rng.uniform(-124, -114, n),
    )


def test_predict_returns_one_prediction_per_input_row():
    train_x = _synthetic_frame(50)
    train_y = train_x.med_inc * 2 + 1

    model = HousePredictionModel().fit(train_x, train_y)

    test_x = _synthetic_frame(10)
    predictions = model.predict(test_x)

    assert len(predictions) == len(test_x)
    assert len(predictions.price) == 10
