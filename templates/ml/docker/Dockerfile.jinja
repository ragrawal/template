# Multi-stage build for the {{ package_name }} house-price serving app.
#
# Expects a pre-trained model artifact at models/model.pkl in the build
# context (run `python -m {{ package_name }}.tasks.train_model` first) --
# this image does not train the model itself.
#
# The base image below pins Python 3.12; adjust it if this project pins a
# different version in .python-version.
#
# Build from the project root (not from docker/), so the build context
# includes pyproject.toml, uv.lock, src/, webapp/, and models/:
#   docker build -f docker/Dockerfile -t {{ package_name }} .

FROM ghcr.io/astral-sh/uv:python3.12-bookworm-slim AS builder

WORKDIR /app

COPY pyproject.toml uv.lock ./
COPY src ./src
COPY README.md ./

RUN uv sync --frozen --no-dev

FROM python:3.12-slim-bookworm AS runtime

WORKDIR /app

COPY --from=builder /app/.venv ./.venv
COPY --from=builder /app/src ./src
COPY webapp ./webapp
COPY models ./models

ENV PATH="/app/.venv/bin:$PATH"
EXPOSE 8080

CMD ["uvicorn", "webapp.app:app", "--host", "0.0.0.0", "--port", "8080"]
